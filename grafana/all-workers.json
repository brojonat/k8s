{
  "title": "All Workers - Activity Metrics",
  "tags": ["workers", "workflows", "temporal"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "TemporalMetrics",
        "query": "label_values(poll_activity_duration_seconds_count, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "type": "timeseries",
      "title": "Activity Execution Duration (p50, p95, p99)",
      "datasource": "TemporalMetrics",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (service, activity, le) (rate(poll_activity_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p50 - {{service}} / {{activity}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (service, activity, le) (rate(poll_activity_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p95 - {{service}} / {{activity}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (service, activity, le) (rate(poll_activity_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p99 - {{service}} / {{activity}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 2,
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "type": "timeseries",
      "title": "Activity Execution Rate (per minute)",
      "datasource": "TemporalMetrics",
      "targets": [
        {
          "expr": "sum by (service, activity) (rate(poll_activity_duration_seconds_count{service=~\"$service\"}[5m])) * 60",
          "legendFormat": "{{service}} / {{activity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 3,
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "type": "table",
      "title": "Activity Execution Summary (Last 5 minutes)",
      "datasource": "TemporalMetrics",
      "targets": [
        {
          "expr": "sum by (service, activity) (increase(poll_activity_duration_seconds_count{service=~\"$service\"}[5m]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service": "Service",
              "activity": "Activity",
              "Value": "Executions"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "type": "stat",
      "title": "Total Activity Executions (Last Hour)",
      "datasource": "TemporalMetrics",
      "targets": [
        {
          "expr": "sum by (service) (increase(poll_activity_duration_seconds_count{service=~\"$service\"}[1h]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "type": "stat",
      "title": "Active Services Reporting Metrics",
      "datasource": "TemporalMetrics",
      "targets": [
        {
          "expr": "count(count by (service) (poll_activity_duration_seconds_count{service=~\"$service\"}))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    }
  ]
}
