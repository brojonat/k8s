{
  "dashboard": {
    "title": "All Workers - Activity Metrics",
    "tags": ["workers", "workflows", "temporal"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "P1E53E98DCFC0B173"
          },
          "query": "label_values(poll_activity_duration_seconds_count, service)",
          "refresh": 2,
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "current": {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          "sort": 1
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "type": "graph",
        "title": "Activity Execution Duration (p50, p95, p99)",
        "datasource": {
          "type": "prometheus",
          "uid": "P1E53E98DCFC0B173"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (service, activity, le) (rate(poll_activity_duration_seconds_bucket{service=~\"$service\"}[5m])))",
            "legendFormat": "p50 - {{service}} / {{activity}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          },
          {
            "expr": "histogram_quantile(0.95, sum by (service, activity, le) (rate(poll_activity_duration_seconds_bucket{service=~\"$service\"}[5m])))",
            "legendFormat": "p95 - {{service}} / {{activity}}",
            "refId": "B",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          },
          {
            "expr": "histogram_quantile(0.99, sum by (service, activity, le) (rate(poll_activity_duration_seconds_bucket{service=~\"$service\"}[5m])))",
            "legendFormat": "p99 - {{service}} / {{activity}}",
            "refId": "C",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 2,
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "type": "graph",
        "title": "Activity Execution Rate (per minute)",
        "datasource": {
          "type": "prometheus",
          "uid": "P1E53E98DCFC0B173"
        },
        "targets": [
          {
            "expr": "sum by (service, activity) (rate(poll_activity_duration_seconds_count{service=~\"$service\"}[5m])) * 60",
            "legendFormat": "{{service}} / {{activity}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          }
        ],
        "yaxes": [
          {
            "format": "ops",
            "label": "Executions/min"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 3,
        "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
        "type": "table",
        "title": "Activity Execution Summary (Last 5 minutes)",
        "datasource": {
          "type": "prometheus",
          "uid": "P1E53E98DCFC0B173"
        },
        "targets": [
          {
            "expr": "sum by (service, activity) (increase(poll_activity_duration_seconds_count{service=~\"$service\"}[5m]))",
            "format": "table",
            "instant": true,
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "indexByName": {},
              "renameByName": {
                "service": "Service",
                "activity": "Activity",
                "Value": "Executions"
              }
            }
          }
        ]
      },
      {
        "id": 4,
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
        "type": "stat",
        "title": "Total Activity Executions (Last Hour)",
        "datasource": {
          "type": "prometheus",
          "uid": "P1E53E98DCFC0B173"
        },
        "targets": [
          {
            "expr": "sum by (service) (increase(poll_activity_duration_seconds_count{service=~\"$service\"}[1h]))",
            "legendFormat": "{{service}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 10
                },
                {
                  "color": "green",
                  "value": 50
                }
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 5,
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
        "type": "stat",
        "title": "Active Services Reporting Metrics",
        "datasource": {
          "type": "prometheus",
          "uid": "P1E53E98DCFC0B173"
        },
        "targets": [
          {
            "expr": "count(count by (service) (poll_activity_duration_seconds_count{service=~\"$service\"}))",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "none"
          }
        }
      }
    ]
  },
  "overwrite": true
}
