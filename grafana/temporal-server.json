{
  "dashboard": {
    "title": "Temporal Server Health",
    "tags": ["temporal", "server", "infrastructure"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "type": "graph",
        "title": "Schedule-to-Start Latency by Task Queue (p95)",
        "datasource": {
          "type": "prometheus",
          "uid": "P1E53E98DCFC0B173"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (task_queue, task_type, le) (rate(temporal_server_schedule_to_start_latency_bucket[5m])))",
            "legendFormat": "{{task_queue}} ({{task_type}})",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 2,
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "type": "graph",
        "title": "Workflow Task Execution Latency (p95)",
        "datasource": {
          "type": "prometheus",
          "uid": "P1E53E98DCFC0B173"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (namespace, le) (rate(temporal_server_workflow_task_execution_latency_bucket[5m])))",
            "legendFormat": "{{namespace}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 3,
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "type": "graph",
        "title": "Persistence Operation Latency (p95)",
        "datasource": {
          "type": "prometheus",
          "uid": "P1E53E98DCFC0B173"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(temporal_persistence_latency_bucket[5m])))",
            "legendFormat": "{{operation}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 4,
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "type": "graph",
        "title": "Service Request Rate by Component",
        "datasource": {
          "type": "prometheus",
          "uid": "P1E53E98DCFC0B173"
        },
        "targets": [
          {
            "expr": "sum by (service_name) (rate(temporal_server_service_requests_total[5m]))",
            "legendFormat": "{{service_name}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 5,
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
        "type": "graph",
        "title": "Service Error Rate by Component",
        "datasource": {
          "type": "prometheus",
          "uid": "P1E53E98DCFC0B173"
        },
        "targets": [
          {
            "expr": "sum by (service_name) (rate(temporal_server_service_error_with_type_total[5m]))",
            "legendFormat": "{{service_name}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Errors/sec"
          },
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 6,
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
        "type": "stat",
        "title": "Temporal Components Health",
        "datasource": {
          "type": "prometheus",
          "uid": "P1E53E98DCFC0B173"
        },
        "targets": [
          {
            "expr": "up{job=~\".*temporal.*\"}",
            "legendFormat": "{{job}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "P1E53E98DCFC0B173"
            }
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": { "text": "DOWN", "color": "red" },
                  "1": { "text": "UP", "color": "green" }
                }
              }
            ],
            "unit": "none"
          }
        }
      }
    ]
  },
  "overwrite": true
}
